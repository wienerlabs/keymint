# Zerion API
ZERION_API_KEY=your_zerion_api_key_here
ZERION_BASE_URL=https://api.zerion.io

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# USDC Devnet Mint
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Publisher (API owner) wallet address
PUBLISHER_WALLET=your_publisher_wallet_address_here
PUBLISHER_WALLET_KEYPAIR=/path/to/.config/solana/id.json

# Anchor Program ID (update after deploy)
PROGRAM_ID=EJeBowVHBopARqR3qCNXN7a2iJeM2Zf5c6gd2ZH8Lrs9

# Proxy
PROXY_PORT=4001

# Optional: protect PUT /api/endpoints/price. If unset, the endpoint is disabled.
PUBLISHER_API_KEY=

# Optional: comma-separated origin whitelist for the dashboard API. Defaults to "*".
# Example: CORS_ORIGIN=http://localhost:3000,https://your-dashboard.vercel.app
CORS_ORIGIN=*

# Dashboard
DASHBOARD_PORT=3000
PROXY_API_URL=http://localhost:4001
